{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Base checkout schema. Extensions compose onto this using allOf.",
  "name": "dev.ucp.shopping.checkout",
  "properties": {
    "attribution": {
      "$ref": "types/attribution_create_request.json"
    },
    "buyer": {
      "$ref": "types/buyer_create_request.json",
      "description": "Representation of the buyer."
    },
    "context": {
      "$ref": "types/context_create_request.json"
    },
    "line_items": {
      "description": "List of line items being checked out.",
      "items": {
        "$ref": "types/line_item_create_request.json"
      },
      "type": "array"
    },
    "payment": {
      "$ref": "payment_create_request.json"
    },
    "signals": {
      "$ref": "types/signals_create_request.json"
    }
  },
  "required": [
    "line_items"
  ],
  "title": "Checkout Create Request",
  "type": "object"
}
