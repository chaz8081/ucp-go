{
  "$defs": {
    "request": {
      "description": "Pagination parameters for requests.",
      "properties": {
        "cursor": {
          "description": "Opaque cursor from previous response.",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "description": "Requested page size. Implementations MAY clamp to a lower maximum.",
          "minimum": 1,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "response": {
      "description": "Pagination information in responses.",
      "if": {
        "properties": {
          "has_next_page": {
            "const": true
          }
        },
        "required": [
          "has_next_page"
        ]
      },
      "properties": {
        "cursor": {
          "description": "Cursor to fetch the next page of results. MUST be present when has_next_page is true.",
          "type": "string"
        },
        "has_next_page": {
          "description": "Whether more results are available.",
          "type": "boolean"
        },
        "total_count": {
          "description": "Total number of matching items, if available.",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "has_next_page"
      ],
      "then": {
        "required": [
          "cursor"
        ]
      },
      "type": "object"
    }
  },
  "$id": "https://ucp.dev/schemas/shopping/types/pagination.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Cursor-based pagination for list operations.",
  "title": "Pagination",
  "type": "object"
}
