{
  "$id": "https://ucp.dev/schemas/shopping/types/price.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Price with explicit currency.",
  "properties": {
    "amount": {
      "$ref": "amount.json",
      "description": "Amount in ISO 4217 minor units. Use 0 for free items."
    },
    "currency": {
      "description": "ISO 4217 currency code (e.g., 'USD', 'EUR', 'GBP').",
      "pattern": "^[A-Z]{3}$",
      "type": "string"
    }
  },
  "required": [
    "amount",
    "currency"
  ],
  "title": "Price",
  "type": "object"
}
