{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A product category with optional taxonomy identifier.",
  "properties": {
    "taxonomy": {
      "description": "Source taxonomy. Well-known values: `google_product_category`, `shopify`, `merchant`.",
      "type": "string"
    },
    "value": {
      "description": "Category value or path (e.g., 'Apparel \u003e Shirts', '1604').",
      "type": "string"
    }
  },
  "required": [
    "value"
  ],
  "title": "Category",
  "type": "object"
}
